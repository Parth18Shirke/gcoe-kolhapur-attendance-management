# ==========================================
# Attendance Management System - .gitignore
# ==========================================

# Environment & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.crt
*.pfx

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.next/
out/
dist/
.parcel-cache/

# Testing & Coverage
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# Databases & Local Storage
*.sqlite3
*.db
*.sqlite
data/
media/
uploads/

# Logs & Temporary Files
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
