# ==============================================================================
# College Attendance Management System - Environment Configuration
# ==============================================================================

# Application Runtime
DEBUG=True
SECRET_KEY=insecure-dev-secret-key-change-in-production-!@#$ams2026
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Database Configuration
# Default is local SQLite in dev if DATABASE_URL is not set.
# In Production: postgres://ams_user:strongpassword@localhost:5432/ams_db
DATABASE_URL=sqlite:///db.sqlite3

# Security & CORS (Production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email / Notification Provider
# Options: console (dev testing), smtp (production college server)
EMAIL_PROVIDER=console
EMAIL_HOST=smtp.college.edu
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ams-alerts@college.edu
EMAIL_HOST_PASSWORD=change-to-college-smtp-password
DEFAULT_FROM_EMAIL=College Attendance Cell <ams-alerts@college.edu>

# Institutional Policy Defaults
STATUTORY_ATTENDANCE_THRESHOLD=75.00
NOTIFICATION_COOLDOWN_DAYS=7
FACULTY_CORRECTION_WINDOW_HOURS=24
TIMETABLE_GRACE_PERIOD_MINUTES=120
